# Document OCR API Configuration
# Copy this file to .env and fill in your actual values

# OCR Request Authentication Secret
# Change this to a strong secret in production
OCR_SECRET_KEY=your-ocr-secret-key-here-change-in-production

# Webhook Forwarder Configuration (Optional)
# Leave empty if not using webhook forwarding feature

# Secret key for signing forwarded webhooks
FORWARDER_SECRET=your-forwarder-secret-here

# Webhook target endpoints (up to 3 targets)
FORWARDER_TARGET_1_URL=https://endpoint1.example.com/webhook
FORWARDER_TARGET_2_URL=https://endpoint2.example.com/webhook
FORWARDER_TARGET_3_URL=https://endpoint3.example.com/webhook

# OCR Engine Configuration (Optional)
# Set to 1 to enable EasyOCR fallback if RapidOCR is unavailable
ENABLE_EASYOCR_FALLBACK=0

# Flask Configuration (Optional)
# FLASK_ENV=development
# FLASK_DEBUG=1

